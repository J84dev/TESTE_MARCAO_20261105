# Copie este arquivo para .env e ajuste a conexão.
# O SQL Server NÃO é executado em container por este projeto.
# "host.docker.internal" costuma permitir que o Dev Container alcance
# um SQL Server instalado no Windows host. Ajuste conforme seu ambiente.

SQL_SERVER=host.docker.internal
SQL_PORT=1433
SQL_DATABASE=TesteSolicitacoes
SQL_USERNAME=sa
SQL_PASSWORD=COLOQUE_SUA_SENHA_AQUI
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes
